<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Emoji Scroll — Ultra Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800;900&family=Bebas+Neue&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0e1a;--card:#141c32;--accent:#00d4ff;--money:#39ff7e;
  --common:#94a3b8;--rare:#3b82f6;--srare:#a855f7;--epic:#ec4899;
  --legendary:#f59e0b;--mythique:#f43f5e;--exotic:#f97316;--og:#facc15;
  --glass:rgba(255,255,255,.04);--gb:rgba(255,255,255,.08);
}
*{box-sizing:border-box;font-family:'Nunito',sans-serif;user-select:none;-webkit-tap-highlight-color:transparent;margin:0;padding:0;}
html{font-size:15px;}@media(min-width:768px){html{font-size:17px;}}
body{background:var(--bg);background-image:radial-gradient(ellipse at 20% 50%,rgba(0,212,255,.04),transparent 60%),radial-gradient(ellipse at 80% 20%,rgba(168,85,247,.05),transparent 60%);color:#fff;display:flex;flex-direction:column;align-items:center;overflow-x:hidden;min-height:100vh;}

/* PARTICLES */
#ptcls{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
.pt{position:absolute;border-radius:50%;animation:floatPt linear infinite;opacity:0;}
@keyframes floatPt{0%{transform:translateY(100vh) scale(0);opacity:0;}10%{opacity:.5;}90%{opacity:.2;}100%{transform:translateY(-20px);opacity:0;}}

/* EVENT BG */
#evBg{position:fixed;inset:0;pointer-events:none;z-index:1;opacity:0;transition:opacity 1s;}
#evBg.on{opacity:1;}
.ebg-money{background:radial-gradient(ellipse at center,rgba(57,255,126,.08),transparent 70%);}
.ebg-luck{background:radial-gradient(ellipse at center,rgba(0,212,255,.08),transparent 70%);}
.ebg-mut{background:radial-gradient(ellipse at center,rgba(255,0,255,.08),transparent 70%);}
.ebg-rainbow{animation:bgRainbow 4s linear infinite;}
@keyframes bgRainbow{0%{background:radial-gradient(ellipse at center,rgba(255,50,50,.07),transparent 70%);}25%{background:radial-gradient(ellipse at center,rgba(57,255,126,.07),transparent 70%);}50%{background:radial-gradient(ellipse at center,rgba(0,212,255,.07),transparent 70%);}75%{background:radial-gradient(ellipse at center,rgba(255,0,255,.07),transparent 70%);}100%{background:radial-gradient(ellipse at center,rgba(255,50,50,.07),transparent 70%);}}

/* SPLASH */
#splash{position:fixed;inset:0;background:var(--bg);z-index:10000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;transition:opacity .6s;}
.spl-logo{font-family:'Bebas Neue';font-size:3.5rem;letter-spacing:4px;background:linear-gradient(135deg,#00d4ff,#a855f7,#f97316);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.spl-e{font-size:5rem;animation:splBounce 1s ease-in-out infinite;}
@keyframes splBounce{0%,100%{transform:translateY(0) rotate(-5deg);}50%{transform:translateY(-20px) rotate(5deg);}}

/* EVENT BANNER */
#banner{width:100%;max-width:620px;background:rgba(20,28,50,.9);backdrop-filter:blur(15px);color:#fff;text-align:center;font-size:.7rem;font-weight:900;padding:8px 12px;z-index:200;border-bottom:1px solid var(--gb);font-family:'Bebas Neue';letter-spacing:1px;}
#banner.ev{background:linear-gradient(90deg,#ff4757,#ff6b81,#ff4757)!important;animation:evPulse 1.5s infinite;}
@keyframes evPulse{0%,100%{opacity:.9;}50%{opacity:1;}}

/* BIG EVENT POPUP */
#bigEv{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);z-index:5000;pointer-events:none;}
.bigEv-card{padding:3rem 4rem;border-radius:2rem;text-align:center;border:2px solid rgba(255,255,255,.3);animation:evPop 3.5s forwards;}
@keyframes evPop{0%{transform:scale(.3) rotate(-10deg);opacity:0;}20%{transform:scale(1.1) rotate(2deg);opacity:1;}75%{transform:scale(1);opacity:1;}100%{transform:scale(1.2);opacity:0;}}

/* HUD */
.hud{width:100%;max-width:620px;display:flex;justify-content:space-between;align-items:center;padding:.7rem 1rem;z-index:90;position:relative;}
.luck-pill{background:rgba(0,212,255,.1);border:1px solid var(--accent);padding:.3rem .8rem;border-radius:2rem;font-size:.7rem;font-weight:900;color:var(--accent);}
.money-badge{background:rgba(0,0,0,.6);padding:.4rem 1.2rem;border-radius:3rem;border:2px solid var(--money);font-weight:900;color:var(--money);font-size:1rem;transition:border-color .3s,color .3s;font-family:'Bebas Neue';letter-spacing:1px;}
.top-ctrl{display:flex;gap:.5rem;align-items:center;}
#saveInd{font-size:.6rem;color:var(--money);font-weight:900;opacity:0;transition:opacity .4s;}
.icon-btn{background:var(--glass);border:1px solid var(--gb);width:2.3rem;height:2.3rem;border-radius:.7rem;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1rem;cursor:pointer;transition:all .2s;backdrop-filter:blur(5px);}
.icon-btn:hover{background:var(--gb);transform:translateY(-2px);}
.icon-btn:active{transform:scale(.88);}

/* MAIN */
.main-cont{display:flex;align-items:center;justify-content:center;gap:1.2rem;width:100%;max-width:820px;flex:1;padding:.5rem 1rem;}

/* SIDEBAR */
.side-bar{display:flex;flex-direction:column;gap:.6rem;}
.side-btn{width:2.8rem;height:2.8rem;border-radius:1rem;border:1px solid var(--gb);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.1rem;cursor:pointer;transition:all .25s;backdrop-filter:blur(5px);box-shadow:0 4px 12px rgba(0,0,0,.3);position:relative;}
.side-btn:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 8px 20px rgba(0,0,0,.5);}
.side-btn:active{transform:scale(.9);}
.side-lbl{position:absolute;left:calc(100% + 8px);background:rgba(10,14,26,.97);border:1px solid var(--gb);padding:4px 10px;border-radius:8px;font-size:.65rem;font-weight:800;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;z-index:10;}
.side-btn:hover .side-lbl{opacity:1;}

/* PHONE */
.phone-wrap{display:flex;flex-direction:column;align-items:center;gap:.8rem;}
#phone{width:min(72vw,300px);height:520px;background:linear-gradient(160deg,#141c32,#0a0e1a);border-radius:2.8rem;border:3px solid #1e2d50;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:1.4rem 1.2rem 1.2rem;position:relative;transition:border-color .4s,box-shadow .4s;box-shadow:0 30px 60px -15px rgba(0,0,0,.7),inset 0 0 30px rgba(0,0,0,.5);overflow:hidden;}
#phone::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:80px;height:6px;background:#1e2d50;border-radius:0 0 6px 6px;}
#phone.bag-full-anim{animation:bagShake .4s;}
@keyframes bagShake{0%,100%{transform:translateX(0);}25%{transform:translateX(-8px) rotate(-2deg);}75%{transform:translateX(8px) rotate(2deg);}}
#phone.ev-border{animation:evBorderAnim 1.5s infinite alternate;}
@keyframes evBorderAnim{from{box-shadow:0 30px 60px -15px rgba(0,0,0,.7),0 0 20px var(--ec,#fff);}to{box-shadow:0 30px 60px -15px rgba(0,0,0,.4),0 0 50px var(--ec,#fff);}}
#phoneGlow{position:absolute;inset:-20px;border-radius:3rem;opacity:0;transition:all .5s;pointer-events:none;}

/* RARITY */
.rarity-wrap{text-align:center;width:100%;}
#rarityTag{padding:5px 16px;border-radius:20px;font-size:.65rem;font-weight:900;display:inline-block;text-transform:uppercase;letter-spacing:2px;font-family:'Bebas Neue';transition:all .3s;}
#emojiName{font-size:.95rem;font-weight:800;opacity:.9;margin-top:5px;transition:all .3s;}

/* EMOJI WRAPPER — glow ring properly centered */
#emojiWrap{position:relative;display:flex;align-items:center;justify-content:center;width:130px;height:130px;cursor:pointer;flex-shrink:0;}
#emojiWrap:hover #emojiDisp{transform:scale(1.15) rotate(8deg);}
#emojiWrap:active #emojiDisp{transform:scale(.88) rotate(-8deg);}
#emojiDisp{position:relative;z-index:1;font-size:5.5rem;line-height:1;transition:transform .35s cubic-bezier(.175,.885,.32,1.275),filter .35s;filter:drop-shadow(0 0 20px rgba(255,255,255,.1));}

/* GLOW RING */
#glowRing{position:absolute;inset:-10px;border-radius:50%;pointer-events:none;opacity:0;transition:opacity .4s;z-index:0;}
#glowRing.vis{opacity:1;}
.gr-gold   {box-shadow:0 0 0 3px gold,0 0 25px 10px rgba(255,215,0,.6),0 0 50px 20px rgba(255,215,0,.3);animation:grG 1.5s infinite alternate;}
.gr-diamond{box-shadow:0 0 0 3px #b9f2ff,0 0 25px 10px rgba(185,242,255,.7),0 0 50px 20px rgba(185,242,255,.3);animation:grD 1.5s infinite alternate;}
.gr-rainbow{animation:grR 1.5s linear infinite;}
.gr-master {box-shadow:0 0 0 3px #ff00ff,0 0 30px 12px rgba(255,0,255,.7),0 0 60px 25px rgba(255,0,255,.4);animation:grM 1s infinite alternate;}
@keyframes grG{from{box-shadow:0 0 0 2px gold,0 0 15px 6px rgba(255,215,0,.4);}to{box-shadow:0 0 0 4px gold,0 0 35px 16px rgba(255,215,0,.7);}}
@keyframes grD{from{box-shadow:0 0 0 2px #b9f2ff,0 0 15px 6px rgba(185,242,255,.4);}to{box-shadow:0 0 0 4px #b9f2ff,0 0 40px 18px rgba(185,242,255,.7);}}
@keyframes grR{0%{box-shadow:0 0 0 3px red,0 0 30px 10px rgba(255,0,0,.5);}17%{box-shadow:0 0 0 3px orange,0 0 30px 10px rgba(255,165,0,.5);}33%{box-shadow:0 0 0 3px yellow,0 0 30px 10px rgba(255,255,0,.5);}50%{box-shadow:0 0 0 3px lime,0 0 30px 10px rgba(0,255,0,.5);}67%{box-shadow:0 0 0 3px cyan,0 0 30px 10px rgba(0,255,255,.5);}83%{box-shadow:0 0 0 3px #a855f7,0 0 30px 10px rgba(168,85,247,.5);}100%{box-shadow:0 0 0 3px red,0 0 30px 10px rgba(255,0,0,.5);}}
@keyframes grM{from{box-shadow:0 0 0 3px #ff00ff,0 0 20px 8px rgba(255,0,255,.5);transform:scale(.95);}to{box-shadow:0 0 0 5px #ff00ff,0 0 50px 20px rgba(255,0,255,.8);transform:scale(1.05);}}

/* MUTATIONS */
.mut-gold{filter:drop-shadow(0 0 15px gold) brightness(1.2);}
.mut-diamond{filter:drop-shadow(0 0 15px #b9f2ff) brightness(1.3);}
.mut-rainbow{animation:mutRainbow 3s linear infinite;}
.mut-master{animation:mutMaster 1.5s alternate infinite;}
@keyframes mutRainbow{0%{filter:hue-rotate(0deg) drop-shadow(0 0 15px #fff);}100%{filter:hue-rotate(360deg) drop-shadow(0 0 15px #fff);}}
@keyframes mutMaster{from{transform:scale(1);filter:drop-shadow(0 0 15px #ff00ff);}to{transform:scale(1.08);filter:drop-shadow(0 0 35px #ff00ff) brightness(1.3);}}

/* SCROLL REVEAL */
@keyframes scrollReveal{0%{transform:scale(.5) rotate(-15deg);opacity:0;}70%{transform:scale(1.1) rotate(5deg);}100%{transform:scale(1) rotate(0);opacity:1;}}
.scroll-reveal{animation:scrollReveal .5s cubic-bezier(.175,.885,.32,1.275) both;}
@keyframes noMoneyShake{0%,100%{transform:none;}15%{transform:translateX(-10px) rotate(-5deg);}30%{transform:translateX(10px) rotate(5deg);}45%{transform:translateX(-8px) rotate(-3deg);}60%{transform:translateX(8px) rotate(3deg);}75%{transform:translateX(-4px);}}
.shake{animation:noMoneyShake .5s ease;}

/* PHONE BOTTOM */
.phone-bot{width:100%;text-align:center;}
#mutTag{font-size:.75rem;min-height:20px;font-weight:900;text-transform:uppercase;letter-spacing:2px;font-family:'Bebas Neue';}
#emojiGain{color:var(--money);font-weight:900;font-size:1.3rem;margin-bottom:2px;}
#emojiPrice{opacity:.65;font-size:.75rem;margin-bottom:6px;transition:color .3s;}
.scroll-btn{width:100%;padding:.85rem;border:none;border-radius:1rem;font-weight:900;cursor:pointer;color:#0a0e1a;text-transform:uppercase;font-size:.85rem;letter-spacing:2px;font-family:'Bebas Neue';background:linear-gradient(135deg,#00d4ff,#0090cc);box-shadow:0 4px 0 rgba(0,0,0,.4),0 0 20px rgba(0,212,255,.3);transition:transform .1s,box-shadow .1s;position:relative;overflow:hidden;}
.scroll-btn::after{content:'';position:absolute;inset:0;background:linear-gradient(rgba(255,255,255,.15),transparent);}
.scroll-btn:active{transform:translateY(3px);box-shadow:0 1px 0 rgba(0,0,0,.4);}
.buy-btn{width:100%;padding:.65rem;border:none;border-radius:.8rem;font-weight:900;cursor:pointer;text-transform:uppercase;font-size:.75rem;letter-spacing:1px;font-family:'Bebas Neue';transition:all .15s;margin-top:.35rem;position:relative;overflow:hidden;}
.buy-btn.can{color:#000;background:linear-gradient(135deg,var(--money),#22c55e);box-shadow:0 3px 0 rgba(0,0,0,.4),0 0 15px rgba(57,255,126,.3);}
.buy-btn.can::after{content:'';position:absolute;inset:0;background:linear-gradient(rgba(255,255,255,.2),transparent);}
.buy-btn.can:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.4);}
.buy-btn.cant{color:rgba(255,255,255,.5);background:linear-gradient(135deg,#475569,#334155);cursor:not-allowed;}

/* BOT NAV */
.bot-nav{width:100%;max-width:620px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:.8rem;padding:1rem 1rem 1.5rem;}
.nav-btn{padding:.8rem;border:1px solid var(--gb);border-radius:1rem;font-weight:900;cursor:pointer;color:#fff;text-transform:uppercase;font-size:.7rem;letter-spacing:1px;font-family:'Bebas Neue';background:rgba(20,28,50,.8);backdrop-filter:blur(10px);box-shadow:0 4px 12px rgba(0,0,0,.3);transition:all .2s;display:flex;flex-direction:column;align-items:center;gap:2px;}
.nav-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.4);}
.nav-btn:active{transform:translateY(1px);}
.nav-icon{font-size:1.2rem;}
#rbBtn{background:linear-gradient(135deg,rgba(168,85,247,.3),rgba(168,85,247,.1));border-color:rgba(168,85,247,.4);}

/* PANELS */
.panel{position:fixed;inset:0;background:#080c19;backdrop-filter:blur(30px);display:none;flex-direction:column;z-index:1000;border:1px solid var(--gb);}
.panel.open{display:flex;animation:panelIn .35s cubic-bezier(.165,.84,.44,1);}
@keyframes panelIn{from{transform:translateY(10px) scale(.98);opacity:0;}to{transform:translateY(0) scale(1);opacity:1;}}
.panel-hdr{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 1.4rem .9rem;border-bottom:1px solid var(--gb);background:rgba(255,255,255,.02);}
.panel-hdr h2{font-family:'Bebas Neue';font-size:1.8rem;letter-spacing:3px;}
.panel-close{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);width:2.2rem;height:2.2rem;border-radius:.7rem;color:#ef4444;display:flex;align-items:center;justify-content:center;font-size:1.1rem;cursor:pointer;transition:all .2s;}
.panel-close:hover{background:rgba(239,68,68,.3);transform:rotate(90deg);}
.panel-body{flex:1;overflow-y:auto;padding:1.2rem 1.4rem;scrollbar-width:thin;scrollbar-color:var(--gb) transparent;color:#fff;}

/* CARDS */
.card{background:var(--card);padding:1rem 1.2rem;border-radius:1.2rem;display:flex;align-items:center;margin-bottom:.8rem;border:1px solid var(--gb);transition:all .2s;box-shadow:0 4px 12px rgba(0,0,0,.2);}
.card:hover{border-color:rgba(0,212,255,.15);}
.total-ctr{background:rgba(0,212,255,.08);border:1px solid rgba(0,212,255,.2);padding:1.2rem;border-radius:1.2rem;text-align:center;margin-bottom:1.2rem;}

/* TABS */
.tabs{display:flex;overflow-x:auto;gap:.6rem;margin-bottom:1.2rem;padding-bottom:.3rem;}
.tab-btn{padding:.5rem 1rem;border-radius:.8rem;background:var(--card);border:1px solid var(--gb);color:#fff;font-weight:900;white-space:nowrap;cursor:pointer;transition:all .2s;font-size:.75rem;font-family:'Bebas Neue';letter-spacing:1px;}
.tab-btn.active{background:var(--accent);color:#000;border-color:var(--accent);box-shadow:0 0 15px rgba(0,212,255,.4);}

/* BUTTONS */
.btn{padding:.7rem 1.2rem;border:none;border-radius:.8rem;cursor:pointer;font-weight:900;color:#fff;font-family:'Bebas Neue';letter-spacing:1px;font-size:.85rem;transition:all .2s;box-shadow:0 3px 8px rgba(0,0,0,.3);}
.btn:hover{filter:brightness(1.15);transform:translateY(-1px);}
.btn:active{transform:translateY(1px);filter:brightness(.9);}
.btn.primary{background:linear-gradient(135deg,var(--money),#22c55e);color:#000;}
.btn.danger{background:linear-gradient(135deg,#ef4444,#dc2626);}
.btn.info{background:linear-gradient(135deg,var(--accent),#0090cc);color:#000;}
.btn.ghost{background:var(--glass);border:1px solid var(--gb);}
.btn.purple{background:linear-gradient(135deg,#a855f7,#7c3aed);}
.btn.gold{background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;}
.btn.sm{padding:.4rem .9rem;font-size:.75rem;}
.btn.full{width:100%;padding:1rem;font-size:1rem;}

/* FUSION */
.fusion-slot{width:88px;height:88px;border-radius:1.4rem;border:2px dashed var(--gb);background:var(--glass);display:flex;align-items:center;justify-content:center;font-size:2.5rem;cursor:pointer;transition:all .3s;}
.fusion-slot:hover{border-color:var(--accent);background:rgba(0,212,255,.05);transform:scale(1.05);}
.fusion-slot.filled{border-style:solid;border-color:var(--accent);background:rgba(0,212,255,.08);}
.fus-spin{animation:fusSpin 2s linear infinite;}
@keyframes fusSpin{0%{transform:rotate(0deg) scale(1);filter:hue-rotate(0deg);}100%{transform:rotate(360deg) scale(1.12);filter:hue-rotate(360deg);}}

/* PROGRESS */
.pbar{background:var(--glass);border-radius:10px;height:7px;overflow:hidden;margin-top:5px;}
.pfill{height:100%;border-radius:10px;background:linear-gradient(90deg,var(--accent),var(--money));transition:width .5s;}

/* TOAST */
#toasts{position:fixed;top:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:10px;pointer-events:none;}
.toast{background:rgba(8,12,25,.97);border:1px solid var(--accent);color:#fff;padding:12px 20px;border-radius:12px;backdrop-filter:blur(15px);animation:tIn .3s cubic-bezier(.175,.885,.32,1.275) forwards,tOut .3s forwards 2.7s;font-weight:800;font-size:.85rem;}
.toast.ok{border-color:var(--money);}
.toast.err{border-color:#ef4444;}
@keyframes tIn{from{transform:translateX(100%) scale(.8);opacity:0;}to{transform:none;opacity:1;}}
@keyframes tOut{to{transform:translateX(100%);opacity:0;}}

/* MODAL */
.modal-ov{position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);z-index:10000;display:none;align-items:center;justify-content:center;padding:20px;}
.modal-box{background:linear-gradient(160deg,#141c32,#0a0e1a);border:1px solid var(--gb);padding:2.5rem;border-radius:2rem;width:100%;max-width:420px;text-align:center;box-shadow:0 25px 60px rgba(0,0,0,.7);animation:mIn .4s cubic-bezier(.175,.885,.32,1.275);}
@keyframes mIn{from{transform:scale(.8) translateY(20px);opacity:0;}to{transform:none;opacity:1;}}

/* CONFIRM */
#cfmOv{position:fixed;inset:0;display:none;align-items:flex-end;justify-content:center;z-index:8000;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);}
.cfm-card{background:linear-gradient(160deg,#1a243f,#0e1629);border:2px solid var(--gb);border-radius:2rem 2rem 0 0;padding:2rem;width:100%;max-width:500px;text-align:center;animation:slideUp .4s cubic-bezier(.175,.885,.32,1.275);}
@keyframes slideUp{from{transform:translateY(100%);}to{transform:none;}}
.cfm-emoji{font-size:5rem;margin:1rem 0;}

/* DISCOVERY */
#discOv{position:fixed;inset:0;display:none;align-items:center;justify-content:center;z-index:7000;background:rgba(0,0,0,.75);backdrop-filter:blur(10px);pointer-events:none;}
.disc-card{background:linear-gradient(135deg,#1a2440,#0e1629);border:2px solid gold;border-radius:2rem;padding:2.5rem 3rem;text-align:center;box-shadow:0 0 80px rgba(250,204,21,.4);animation:discAnim 3s forwards;}
@keyframes discAnim{0%{transform:scale(.5) rotate(-10deg);opacity:0;}20%{transform:scale(1.05);opacity:1;}80%{transform:scale(1);opacity:1;}100%{transform:scale(.9);opacity:0;}}

/* FLOATING EVENT EMOJI — discret, intégré au banner */
#evFloat{display:none;}
.skin-card{background:var(--card);padding:1.2rem;border-radius:1.5rem;border:2px solid var(--gb);margin-bottom:1rem;transition:all .3s;position:relative;overflow:hidden;}
.skin-preview{height:70px;border-radius:1rem;margin-bottom:.8rem;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.skin-mini-phone{width:36px;height:52px;border-radius:8px;border:3px solid rgba(255,255,255,.4);background:rgba(0,0,0,.4);}
@keyframes rainbowBorder{0%,100%{border-color:red;}17%{border-color:orange;}33%{border-color:yellow;}50%{border-color:lime;}67%{border-color:cyan;}83%{border-color:#a855f7;}}

/* Rainbow skin active styles */
#phone.skin-rainbow{animation:phoneRainbowBorder 2s linear infinite!important;}
@keyframes phoneRainbowBorder{
  0%{border-color:#ff0000;box-shadow:0 30px 60px -15px rgba(0,0,0,.7),0 0 30px rgba(255,0,0,.6);}
  14%{border-color:#ff8800;box-shadow:0 30px 60px -15px rgba(0,0,0,.7),0 0 30px rgba(255,136,0,.6);}
  28%{border-color:#ffff00;box-shadow:0 30px 60px -15px rgba(0,0,0,.7),0 0 30px rgba(255,255,0,.6);}

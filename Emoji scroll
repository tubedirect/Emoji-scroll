        <button class="btn purple" onclick="adminGive('block')" style="padding:.6rem">AJOUTER UN EMOJI BLOCK</button>
      </div>

      <div class="card" style="flex-direction:column;align-items:stretch;gap:.5rem;border:2px solid rgba(0,212,255,.35)">
        <div style="font-weight:900;color:var(--accent);font-family:'Bebas Neue';letter-spacing:1px;font-size:1rem">📖 INDEX COMPLET</div>
        <div style="font-size:.72rem;opacity:.6;line-height:1.5">Débloque tous les émojis dans l'index (toutes raretés × toutes mutations). N'ajoute pas au sac.</div>
        <button class="btn info" onclick="adminGive('index')" style="padding:.7rem;font-size:.85rem">✅ TOUT DÉBLOQUER L'INDEX</button>
      </div>

    </div>`;
  adminSelectedMut='Normal';
}
let adminSelectedMut='Normal';
function adminUpdateEmojiPick(){
  const rar=document.getElementById('adm_rar').value;
  const sel=document.getElementById('adm_emoji');
  sel.innerHTML=EMOJIS[rar].map(e=>`<option value="${e.s}__${e.n}" style="background:#0a0e1a">${e.s} ${e.n}</option>`).join('');
}
function adminSelectMut(name){
  adminSelectedMut=name;
  document.querySelectorAll('[id^="admut_"]').forEach(b=>{
    b.className=b.id==='admut_'+name?'btn info sm':'btn ghost sm';
    b.style.flex='1';b.style.fontSize='.65rem';
  });
}
function adminAddEmoji(){
  const rar=document.getElementById('adm_rar').value;
  const val=document.getElementById('adm_emoji').value.split('__');
  const sym=val[0],name=val.slice(1).join('__');
  const mut=adminSelectedMut==='Normal'?NO_MUT:(MUTS.find(m=>m.name===adminSelectedMut)||NO_MUT);
  const slots=effSlots();
  if(inventory.length>=slots){showToast('Sac plein !','err');return;}
  inventory.push({symbol:sym,name,rarity:rar,price:RD[rar].p,gain:Math.floor(RD[rar].p*.1*mut.multi),mut,mutCls:mut.cls,mutColor:mut.color,mutGr:mut.gr,color:RD[rar].c,glow:RD[rar].glow,mutName:mut.name==='Normal'?'':mut.name,id:Date.now()});
  showToast('✅ '+sym+' '+name+(mut.name!=='Normal'?' ['+mut.name+']':'')+' ajouté !','ok');
  playSFX('buy');updateUI();saveGame();
}
function adminGive(type){
  if(type==='money'){const v=parseFloat(document.getElementById('adm_money').value||0);money+=v;showToast('💰 +'+fmt(v)+' $','ok');}
  else if(type==='reb'){const v=parseInt(document.getElementById('adm_reb').value||0);rebirthLv+=v;totalSlots+=v;showToast('⭐ +'+v+' rebirths','ok');}
  else if(type==='skins'){SKINS.forEach(s=>{if(!ownedSkins.includes(s.id))ownedSkins.push(s.id);});INDEX_CASES.forEach(c=>{if(!ownedSkins.includes(c.id))ownedSkins.push(c.id);});showToast('🎨 Toutes les coques (y compris exclusives) débloquées !','ok');}
  else if(type==='phones'){[...PHONES_BASE,...SHOP_PHONES].forEach(p=>{if(!ownedPhones.includes(p.n))ownedPhones.push(p.n);});showToast('📱 Tous les phones débloqués !','ok');}
  else if(type==='block'){emojiBlocks.push({id:Date.now()});showToast('📦 Emoji Block ajouté !','ok');}
  else if(type==='index'){
    // Unlock every emoji × every mutation tab in the discovered index
    const tabs=['Normal',...MUTS.map(m=>m.name)];
    Object.values(EMOJIS).forEach(arr=>{
      arr.forEach(e=>{
        tabs.forEach(tab=>{
          const k=e.n+'__'+tab;
          if(!discovered[k])discovered[k]=1;
        });
      });
    });
    showToast('📖 Index complet débloqué ! ('+Object.keys(discovered).length+' entrées)','ok');
    playSFX('leg');
  }
  updateUI();saveGame();
}
function adminActivateEvent(key){
  const ev=EVENTS.find(e=>e.key===key);if(!ev)return;
  evActive=key;evDef=ev;evPhase=true;evEnd=Date.now()+ev.dur;
  applyEvBg(ev);showToast('🔥 Événement '+evLbl(ev)+' activé !','ok');
}


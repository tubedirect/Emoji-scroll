// LEADERBOARD
// ═══════════════════════════════════════════════
function renderRank(){
  // Revenu base du joueur SANS bonus event (comparaison équitable)
  const myIncBase=inventory.reduce((a,e)=>a+(e.gain||0),0);
  const myInc=getIncome();

  // Ratio: #1=400M, #99=500 — formule géométrique déterministe
  const TOP_VAL=400000000, BOT_VAL=500;
  const RATIO=Math.pow(BOT_VAL/TOP_VAL,1/98);
  const bots=BOT_NAMES.slice(0,99).map((n,i)=>{
    const base=TOP_VAL*Math.pow(RATIO,i);
    // Variation stable basée sur le nom (pas de Math.random ici)
    const seed=((n.charCodeAt(0)*31+n.length*7)%20)/100; // 0..0.19
    const income=i===0?400000000:Math.floor(base*(0.9+seed));
    return {name:n, income:income, me:false};
  });
  bots.push({name:'▶ TOI', income:myIncBase, me:true});
  bots.sort((a,b)=>b.income-a.income);

  const medals=['🥇','🥈','🥉'];
  const myIdx=bots.findIndex(u=>u.me);
  const myPos=myIdx+1;
  const isFirst=myPos===1;
  const above=myIdx>0?bots[myIdx-1]:null;
  const gap=above?above.income-myIncBase:0;

  // Récompense coque Champion
  if(isFirst&&!ownedSkins.includes('case_rank1')){
    ownedSkins.push('case_rank1');
    showToast('🏆 Coque Champion débloquée !','ok');
    playSFX('leg');saveGame();
  }

  document.getElementById('rankList').innerHTML=
    `<div style="text-align:center;margin-bottom:1.2rem;background:rgba(255,255,255,.03);border:1px solid ${isFirst?'gold':'var(--gb)'};border-radius:1.2rem;padding:1rem">
      <div style="font-size:${isFirst?'2':'1.5'}rem;font-family:'Bebas Neue';color:${isFirst?'gold':'var(--accent)'};letter-spacing:2px">${isFirst?'👑 CHAMPION':'#'+myPos}</div>
      <div style="font-size:.78rem;opacity:.7;margin-top:.3rem;color:var(--money);font-family:'Bebas Neue'">${fmt(myInc)}/s</div>
      <div style="font-size:.68rem;opacity:.5;margin-top:.2rem">${isFirst?'🏆 Coque exclusive débloquée !':above?`→ #${myPos-1} dans +${fmt(gap)}/s`:'Continue à scroller !'}</div>
     </div>`+
    bots.map((u,i)=>{
      const col=i===0?'gold':i===1?'#c0c0c0':i===2?'#cd7f32':'rgba(255,255,255,.55)';
      return `<div class="card" style="margin-bottom:.4rem;padding:.6rem .9rem;${u.me?'border:2px solid var(--accent);background:rgba(0,212,255,.07);':'border:1px solid rgba(255,255,255,.06);'}">
        <div style="font-size:${i<3?.95:.8}rem;width:2.4rem;text-align:center;font-family:'Bebas Neue';flex-shrink:0;color:${col}">${i<3?medals[i]:'#'+(i+1)}</div>
        <div style="flex:1;font-weight:${u.me?900:500};color:${u.me?'var(--accent)':i<3?col:'rgba(255,255,255,.8)'};font-size:.85rem">${u.name}</div>
        <div style="color:var(--money);font-weight:900;font-size:.75rem;font-family:'Bebas Neue'">${fmt(u.income)}/s</div>
      </div>`;
    }).join('');
}


function updateFusSt(){
  const el=document.getElementById('fusSt');if(!el)return;
  if(fusBusy)el.innerHTML=`<div style="font-size:2rem;font-family:'Bebas Neue';color:var(--accent)">${fmtT(fusEnd-Date.now())}</div><p style="opacity:.6;font-size:.8rem">Fusion en cours...</p>`;
  else if(fusResult)el.innerHTML=`<div style="font-size:3rem;margin:.5rem 0" class="${fusResult.mutCls}">${fusResult.symbol}</div><button class="btn primary" onclick="claimFus()">⚡ CLAIM (+${fmt(fusResult.gain)}/s)</button>`;
  else{const can=fusSlots[0]!==null&&fusSlots[1]!==null;el.innerHTML=`<button class="btn${can?' purple':' ghost'}" style="padding:.8rem 2rem" onclick="startFus()">🌀 FUSIONNER</button>`;}
}
function pickFus(slot){
  if(fusBusy||fusResult)return;
  document.getElementById('fusPick').innerHTML=inventory.map((e,i)=>{
    const used=fusSlots.includes(i);
    return `<div class="card" style="opacity:${used?.3:1};cursor:${used?'not-allowed':'pointer'}" onclick="${used?'':`setFusSlot(${slot},${i})`}"><span class="${e.mutCls||''}" style="font-size:1.8rem;margin-right:.8rem">${e.symbol}</span><span style="font-weight:900">${e.name}</span><span style="margin-left:auto;opacity:.6;font-size:.8rem">${e.rarity}</span></div>`;
  }).join('')||`<p style="opacity:.4;text-align:center">Sac vide</p>`;
}
function setFusSlot(slot,i){
  if(fusSlots.includes(i))return;
  if(inventory[i]&&inventory[i].name==='Hybride'){showToast('Hybride bloqué dans la machine !','err');playSFX('error');return;}
  const oth=slot===0?fusSlots[1]:fusSlots[0];
  if(oth!==null&&inventory[oth]&&inventory[i]&&inventory[i].symbol===inventory[oth].symbol){showToast('Émojis identiques bloqués !','err');playSFX('error');return;}
  fusSlots[slot]=i;document.getElementById('fusPick').innerHTML='';renderFusion();
}
function startFus(){
  if(fusSlots[0]===null||fusSlots[1]===null){playSFX('error');return;}
  const e1=inventory[fusSlots[0]],e2=inventory[fusSlots[1]];
  if(!e1||!e2)return;
  fusBusy=true;fusEnd=Date.now()+60000;
  fusResult={symbol:e1.symbol+e2.symbol,name:'Hybride',rarity:'Exotique',color:'#fff',gain:(e1.gain+e2.gain)*3,mutCls:'mut-rainbow',mutName:'FUSION',mutColor:'#ff6b81',price:0,mut:{}};
  const idx=[...fusSlots].sort((a,b)=>b-a);
  idx.forEach(i=>{if(i!==null)inventory.splice(i,1);});
  fusSlots=[null,null];stats.fusions++;renderFusion();playSFX('start');saveGame();
}
function resetFus(){fusSlots=[null,null];fusBusy=false;fusResult=null;fusEnd=null;renderFusion();}
function claimFus(){
  const slots=effSlots();
  if(inventory.length<slots){inventory.push({...fusResult,id:Date.now()});fusResult=null;renderFusion();updateUI();playSFX('buy');}
  else showToast('Sac plein !','err');
}


}

// ═══════════════════════════════════════════════
// EVENTS
// ═══════════════════════════════════════════════
function applyEvBg(def){
  const bg=document.getElementById('evBg'),ph=document.getElementById('phone');
  if(!def){
    bg.className='';bg.classList.remove('on');
    ph.classList.remove('ev-border');ph.style.removeProperty('--ec');
    return;
  }
  bg.className='ebg-'+def.bg+' on';
  ph.classList.add('ev-border');ph.style.setProperty('--ec',def.color);
}
function tickEvents(){
  const now=Date.now(),ban=document.getElementById('banner');
  if(!evPhase){
    if(now>=evNext){
      evPhase=true;
      evDef=EVENTS[Math.floor(Math.random()*EVENTS.length)];
      evActive=evDef.key;
      evEnd=now+evDef.dur;
      ban.classList.add('ev');
      applyEvBg(evDef);
      playSFX('leg');
      const card=document.querySelector('.bigEv-card');
      if(card)card.style.background='linear-gradient(135deg,'+evDef.color+'99,'+evDef.color+'44)';
      document.getElementById('bigEvName').textContent=evLbl(evDef);
      const bv=document.getElementById('bigEv');bv.style.display='flex';
      setTimeout(()=>bv.style.display='none',3500);
    } else {
      ban.textContent=t('nextEvent')+' '+fmtT(evNext-now);
    }
  } else {
    if(now>=evEnd){
      evPhase=false;evActive=null;evDef=null;evNext=now+300000;
      ban.classList.remove('ev');applyEvBg(null);
    } else {
      ban.textContent='🔥 '+evLbl(evDef)+' ('+fmtT(evEnd-now)+') 🔥';
    }
  }
  // Shop timer
  const st=document.getElementById('shopTimer');
  if(st){
    if(now>=shopReset){refreshShop();if(document.getElementById('shopPanel').classList.contains('open'))renderShop();}
    st.textContent=fmtT(Math.max(0,shopReset-now));
  }
}

// ═══════════════════════════════════════════════
// SAVE / LOAD
// ═══════════════════════════════════════════════
const SAVE_KEY='emojiScrollV15';
function saveGame(){
  try{
    localStorage.setItem(SAVE_KEY,JSON.stringify({
      money,inventory,rebirthLv,phoneIdx,totalSlots,stats,
      ownedPhones,ownedSkins,skinId,discovered,
      sfxOn,lang,tutDone,
      shopPhones,shopSkins,shopCodes,shopReset,boughtShopCodes,boughtShopPhones,
      fusSlots,fusBusy,fusEnd,fusResult,claimed,
      evActive,evDef,evPhase,evEnd,evNext,
      confirmSettings,adminUnlocked,emojiBlocks,usedCodes,shopHasBlock
    }));
    const ind=document.getElementById('saveInd');
    if(ind){ind.style.opacity='1';setTimeout(()=>ind.style.opacity='0',1500);}
  }catch(e){console.warn('Save error',e);}
}
function loadGame(){
  try{
    const raw=localStorage.getItem(SAVE_KEY);if(!raw)return;
    const d=JSON.parse(raw);
    money=d.money??100;inventory=d.inventory??[];rebirthLv=d.rebirthLv??0;phoneIdx=d.phoneIdx??0;totalSlots=d.totalSlots??4;
    stats=Object.assign({total:0,scrolls:0,fusions:0,bagFills:0,mutGold:0,mutMaster:0,legFound:0,ogFound:0},d.stats??{});
    ownedPhones=d.ownedPhones??['Nokia 3310'];ownedSkins=d.ownedSkins??['grey'];skinId=d.skinId??'grey';
    discovered=d.discovered??{};sfxOn=d.sfxOn??true;lang=d.lang??'fr';tutDone=d.tutDone??false;
    shopPhones=d.shopPhones??[];shopSkins=d.shopSkins??[];shopCodes=d.shopCodes??[];shopReset=d.shopReset??Date.now()+120000;shopHasBlock=d.shopHasBlock??false;
    boughtShopCodes=d.boughtShopCodes??[];boughtShopPhones=d.boughtShopPhones??[];
    fusSlots=d.fusSlots??[null,null];fusBusy=d.fusBusy??false;fusEnd=d.fusEnd??null;fusResult=d.fusResult??null;claimed=d.claimed??[];
    evActive=d.evActive??null;evDef=d.evDef??null;evPhase=d.evPhase??false;evEnd=d.evEnd??0;evNext=d.evNext??Date.now()+60000;
    confirmSettings=Object.assign({mythique:true,exotique:true,og:true,master:true},d.confirmSettings??{});
    adminUnlocked=d.adminUnlocked??false;
    emojiBlocks=d.emojiBlocks??[];
    usedCodes=d.usedCodes??[];
    if(fusBusy&&fusEnd&&fusEnd<Date.now())fusBusy=false;
    if(evPhase&&evDef)applyEvBg(evDef);
    const sb=document.getElementById('sfxBtn');if(sb){sb.textContent=sfxOn?'ON':'OFF';sb.className='btn '+(sfxOn?'primary':'danger');}
    if(!shopPhones.length||!shopCodes.length||!shopSkins.length)refreshShop();
  }catch(e){console.warn('Load error',e);}
}

// ═══════════════════════════════════════════════
// SFX TOGGLE
// ═══════════════════════════════════════════════
function toggleSFX(){
  sfxOn=!sfxOn;
  const b=document.getElementById('sfxBtn');
  b.textContent=sfxOn?'ON':'OFF';b.className='btn '+(sfxOn?'primary':'danger');
  saveGame();
}

// ═══════════════════════════════════════════════
// RESET
// ═══════════════════════════════════════════════
function askReset(){
  showModal('⚠️ RESET',t('resetConfirm'),[
    {text:t('no'),cls:'ghost'},
    {text:t('yes'),cls:'danger',fn:()=>{
      localStorage.removeItem(SAVE_KEY);
      // Réinitialisation complète de toutes les variables avant reload
      shopPhones=[];shopSkins=[];shopCodes=[];shopHasBlock=false;
      boughtShopCodes=[];boughtShopPhones=[];
      shopReset=Date.now()+120000;
      window.location.reload();
    }}
  ],'⚠️');
}

// ═══════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════
function initGame(){
  loadGame();
  initParts();
  applySkin();
  updateUI();
  updateAllTexts();
  // Si sauvegarde existante, passer le splash automatiquement
  if(tutDone){
    const s=document.getElementById('splash');
    if(s){s.style.display='none';}
    document.getElementById('banner').style.display='';
    document.querySelector('.hud').style.display='';
    document.querySelector('.main-cont').style.display='';
    document.querySelector('.bot-nav').style.display='';
    setTimeout(()=>{if(musicOn)initMusic();},500);
  }
  // Autosave every 5s
  setInterval(saveGame,5000);
}

// ═══════════════════════════════════════════════
// MAIN LOOP — 100ms tick
// ═══════════════════════════════════════════════
setInterval(()=>{
  const earned=getIncome()/10;
  money+=earned;
  stats.total+=earned;
  // Fusion timer
  if(fusBusy&&fusEnd&&Date.now()>=fusEnd){
    fusBusy=false;
    if(document.getElementById('fusionPanel').classList.contains('open'))updateFusSt();
  }
  tickEvents();
  updateUI();
},100);

// Start
initGame();
</script>

  let frame=0,speed=100,idx2=0;
  const emoEl=document.createElement('div');
  emoEl.style.cssText='font-size:6rem;transition:transform .1s';
  const lbl=document.createElement('div');
  lbl.style.cssText='font-family:"Bebas Neue";font-size:1.2rem;letter-spacing:3px;opacity:.6';
  lbl.textContent='OUVERTURE...';
  modal.appendChild(emoEl);modal.appendChild(lbl);
  document.body.appendChild(modal);
  const rar=pickBlockReward();
  const pool=EMOJIS[rar];
  const em=pool[Math.floor(Math.random()*pool.length)];
  const mut=Math.random()<0.3?MUTS[Math.floor(Math.random()*MUTS.length)]:NO_MUT;

function updateUI(){
  document.getElementById('moneyDisp').textContent=fmt(money)+' $';
  const slots=effSlots();
  document.getElementById('slotsDisp').textContent=inventory.length+'/'+slots;
  const ap=curPhone();
  document.getElementById('luckDisp').textContent=fmt(ap.l);
  // Nom du phone dans la luck-pill uniquement (plus de phoneName redondant sous le téléphone)
  const pnh=document.getElementById('phoneNameHud');if(pnh)pnh.textContent=ap.n;

  if(curEmoji){
    const d=document.getElementById('emojiDisp');
    d.textContent=curEmoji.symbol;
    if(!d.classList.contains('scroll-reveal'))d.className=curEmoji.mutCls||'';

    document.getElementById('emojiName').textContent=curEmoji.name;

    const rt=document.getElementById('rarityTag');
    rt.textContent=curEmoji.rarity;
    rt.style.background=curEmoji.color+'33';
    rt.style.color=curEmoji.color;
    rt.style.border='1px solid '+curEmoji.color+'66';

    const ml=mutLbl(curEmoji.mut);
    document.getElementById('mutTag').textContent=ml;
    document.getElementById('mutTag').style.color=curEmoji.mutColor||curEmoji.color;
    document.getElementById('emojiGain').textContent='+'+fmt(curEmoji.gain)+'/s';
    document.getElementById('emojiPrice').textContent=fmt(curEmoji.price)+' $';

    // Glow ring
    const gr=document.getElementById('glowRing');
    if(curEmoji.mutGr){gr.className='vis '+curEmoji.mutGr;}
    else gr.className='';

    // Phone glow
    const pg=document.getElementById('phoneGlow');
    pg.style.background='radial-gradient(circle,'+curEmoji.glow+' 0%,transparent 70%)';
    pg.style.opacity='1';

    // Buy btn
    const bb=document.getElementById('buyBtn');
    const canBuy=money>=curEmoji.price&&inventory.length<slots;
    bb.textContent='ACHETER — '+fmt(curEmoji.price)+' $';
    bb.className='buy-btn '+(canBuy?'can':'cant');
  } else {
    document.getElementById('glowRing').className='';
    document.getElementById('buyBtn').className='buy-btn cant';
  }
}


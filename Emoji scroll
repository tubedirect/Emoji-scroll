// MUSIC — generative ambient track via Web Audio
// ═══════════════════════════════════════════════
let musicCtx=null, musicOn=true, musicVol=0.4;
let musicGain=null, musicNodes=[], musicScheduled=false;

function initMusic(){
  if(musicCtx)return;
  try{
    musicCtx=new(window.AudioContext||window.webkitAudioContext)();
    musicGain=musicCtx.createGain();
    musicGain.gain.setValueAtTime(musicVol,musicCtx.currentTime);
    // Reverb via convolver
    const conv=musicCtx.createConvolver();
    const bufLen=musicCtx.sampleRate*2;
    const buf=musicCtx.createBuffer(2,bufLen,musicCtx.sampleRate);
    for(let c=0;c<2;c++){const d=buf.getChannelData(c);for(let i=0;i<bufLen;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/bufLen,3);}
    conv.buffer=buf;
    const convGain=musicCtx.createGain();convGain.gain.value=0.25;
    musicGain.connect(conv);conv.connect(convGain);convGain.connect(musicCtx.destination);
    musicGain.connect(musicCtx.destination);
    startMusicLoop();
  }catch(e){console.warn('Music init failed',e);}
}

// Pentatonic scale frequencies (C major pentatonic + octave)
const PENTA=[261.63,293.66,329.63,392,440, 523.25,587.33,659.25,783.99,880];
const BASS=[65.41,73.42,82.41,98,110];
const CHORDS=[[0,2,4],[1,3,5],[2,4,6],[0,4,7]]; // indices into PENTA

function musicNote(freq,startT,dur,vol,type='sine'){
  if(!musicCtx||!musicGain)return;
  const osc=musicCtx.createOscillator();
  const g=musicCtx.createGain();
  osc.type=type;
  osc.frequency.setValueAtTime(freq,startT);
  g.gain.setValueAtTime(0,startT);
  g.gain.linearRampToValueAtTime(vol,startT+0.03);
  g.gain.exponentialRampToValueAtTime(0.001,startT+dur);
  osc.connect(g);g.connect(musicGain);
  osc.start(startT);osc.stop(startT+dur+0.05);
  return osc;
}

let musicPhase=0;
function startMusicLoop(){
  if(!musicCtx||!musicOn)return;
  const now=musicCtx.currentTime;
  const bpm=110, beat=60/bpm;
  const loopBars=8, totalBeats=loopBars*4;

  // Bass line
  for(let b=0;b<totalBeats;b+=2){
    const t=now+b*beat;
    const bassFreq=BASS[Math.floor((musicPhase+b/2)%BASS.length)];
    musicNote(bassFreq,t,beat*1.8,0.18,'triangle');
  }

  // Melody — arpeggiated chord
  for(let b=0;b<totalBeats;b++){
    const t=now+b*beat;
    const chordIdx=Math.floor(b/4)%CHORDS.length;
    const chord=CHORDS[chordIdx];
    const noteIdx=chord[b%chord.length];
    musicNote(PENTA[noteIdx],t,beat*0.6,0.06,'sine');
  }

  // Sparkle high notes every 2 beats
  for(let b=0;b<totalBeats;b+=3){
    const t=now+b*beat+beat*0.5;
    const freq=PENTA[5+Math.floor(Math.random()*5)];
    musicNote(freq,t,beat*0.3,0.04,'sine');
  }

  // Pad chords
  for(let b=0;b<loopBars;b++){
    const t=now+b*4*beat;
    const chordIdx=b%CHORDS.length;
    CHORDS[chordIdx].forEach((ni,i)=>{
      musicNote(PENTA[ni]*0.5,t+i*0.02,beat*3.5,0.04,'triangle');
    });
  }

  musicPhase=(musicPhase+1)%BASS.length;
  const loopDur=totalBeats*beat*1000-100;
  if(musicOn)setTimeout(startMusicLoop,loopDur);
}

function toggleMusic(){
  musicOn=!musicOn;
  const btn=document.getElementById('musicToggleBtn');
  if(musicOn){
    if(!musicCtx){initMusic();}
    else{if(musicCtx.state==='suspended')musicCtx.resume();startMusicLoop();}
    if(btn)btn.textContent='🎵';
  } else {
    if(btn)btn.textContent='🔇';
    if(musicGain)musicGain.gain.setTargetAtTime(0,musicCtx.currentTime,0.2);
    setTimeout(()=>{if(!musicOn&&musicGain)musicGain.gain.setValueAtTime(0,musicCtx.currentTime);},500);
  }
}

function setMusicVol(v){
  musicVol=v/100;
  if(musicGain&&musicOn){
    musicGain.gain.setTargetAtTime(musicVol,musicCtx.currentTime,0.1);
  }
  const btn=document.getElementById('musicToggleBtn');
  if(btn)btn.textContent=musicVol===0?'🔇':musicVol<0.4?'🔉':'🎵';
}



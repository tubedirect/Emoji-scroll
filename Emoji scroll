// EMOJI BLOCK opening
const BLOCK_REWARDS=[
  {weight:45,rarity:'Common'},
  {weight:30,rarity:'Rare'},
  {weight:15,rarity:'Super Rare'},
  {weight:6, rarity:'Epic'},
  {weight:3, rarity:'Legendary'},
  {weight:.8,rarity:'Mythique'},
  {weight:.2,rarity:'OG'}
];
function pickBlockReward(){
  const total=BLOCK_REWARDS.reduce((s,r)=>s+r.weight,0);
  let r=Math.random()*total;
  for(const rw of BLOCK_REWARDS){r-=rw.weight;if(r<=0)return rw.rarity;}
  return 'Common';
}
function openEmojiBlock(i){
  emojiBlocks.splice(i,1);
  // Animate
  const modal=document.createElement('div');
  modal.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:12000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem';

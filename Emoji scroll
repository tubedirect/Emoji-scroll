function doScroll(){
  stats.scrolls++;
  playSFX('scroll');
  const ph=document.getElementById('phone');
  ph.style.transform='rotateX(8deg) scale(.97)';
  setTimeout(()=>ph.style.transform='',120);

  const ap=curPhone();
  let luck=ap.l;
  if(evActive==='luck2')luck*=2;
  else if(evActive==='luck4')luck*=4;
  else if(evActive==='mega')luck*=3;

  // Pick rarity
  const r=Math.random()*100;
  let rar='Common';
  for(const k of ['OG','Exotique','Mythique','Legendary','Epic','Super Rare','Rare']){
    if(r<RD[k].th*luck){rar=k;break;}
  }

  // Pick emoji
  const pool=EMOJIS[rar];
  const em=pool[Math.floor(Math.random()*pool.length)];

  // Mutation
  let mutBonus=1;
  if(evActive==='mutations'||evActive==='rainbow')mutBonus=5;
  let mut=NO_MUT;
  if(adminForcedMut){
    mut=MUTS.find(m=>m.name===adminForcedMut)||NO_MUT;
    adminForcedMut=null; // consume the forced mutation
  } else {
    const mr=Math.random()*100;
    for(const m of MUTS){if(mr<m.chance*mutBonus){mut=m;break;}}
  }

  // Income multiplier
  let gainMul=mut.multi;
  if(evActive==='money2')gainMul*=2;
  else if(evActive==='money4')gainMul*=4;

  const priceBase=RD[rar].p*(0.8+Math.random()*.4)*(evActive==='cheap'?0.5:1);

  curEmoji={
    symbol:em.s, name:em.n, rarity:rar,
    price:Math.floor(priceBase),
    gain:Math.floor(RD[rar].p*.1*gainMul),
    mut, mutCls:mut.cls, mutColor:mut.color, mutGr:mut.gr,
    color:RD[rar].c, glow:RD[rar].glow,
    mutName:mut.name==='Normal'?'':mut.name
  };

  // Animate
  const disp=document.getElementById('emojiDisp');
  disp.className='scroll-reveal '+(curEmoji.mutCls||'');

  // Show confirm for rare/special — respect settings
  const specRar=['OG','Exotique','Mythique'];
  const specMut=['MASTER','ARC-EN-CIEL'];
  let shouldConfirm=false;
  if(rar==='Mythique'&&confirmSettings.mythique)shouldConfirm=true;
  if(rar==='Exotique'&&confirmSettings.exotique)shouldConfirm=true;
  if(rar==='OG'&&confirmSettings.og)shouldConfirm=true;
  if(mut.name==='MASTER'&&confirmSettings.master)shouldConfirm=true;
  if(mut.name==='ARC-EN-CIEL'&&confirmSettings.master)shouldConfirm=true;
  if(shouldConfirm){
    pendingCfm=curEmoji;
    showCfm(curEmoji);
    playSFX('leg');
  }
  updateUI();
}

function showCfm(e){
  document.getElementById('cfmE').textContent=e.symbol;
  document.getElementById('cfmE').className='cfm-emoji '+(e.mutCls||'');
  document.getElementById('cfmN').textContent=e.name;
  document.getElementById('cfmR').textContent='✦ '+e.rarity+' ✦';
  document.getElementById('cfmR').style.color=e.color;
  const ml=mutLbl(e.mut);
  document.getElementById('cfmM').textContent=ml?'⚡ MUTATION: '+ml:'';
  document.getElementById('cfmM').style.color=e.mutColor||'#fff';
  document.getElementById('cfmOv').style.display='flex';
}
function doCfmBuy(){
  document.getElementById('cfmOv').style.display='none';
  if(pendingCfm){buyDirect(pendingCfm);pendingCfm=null;}
}
function cancelCfm(){
  document.getElementById('cfmOv').style.display='none';
  pendingCfm=null;
  doScroll();
}
function buyCurrentEmoji(){
  if(!curEmoji)return;
  if(document.getElementById('cfmOv').style.display==='flex')return;
  buyDirect(curEmoji);
}

function buyDirect(e){
  const slots=effSlots();
  if(inventory.length>=slots){
    playSFX('error');showToast(t('bagFull'),'err');
    const ph=document.getElementById('phone');ph.classList.add('bag-full-anim');setTimeout(()=>ph.classList.remove('bag-full-anim'),500);
    return;
  }
  if(money<e.price){
    playSFX('error');showToast(t('noMoney'),'err');
    const d=document.getElementById('emojiDisp');d.classList.add('shake');setTimeout(()=>d.classList.remove('shake'),600);
    const pe=document.getElementById('emojiPrice');pe.style.color='#ef4444';pe.style.fontWeight='900';setTimeout(()=>{pe.style.color='';pe.style.fontWeight='';},600);
    const mb=document.getElementById('moneyDisp');mb.style.borderColor='#ef4444';mb.style.color='#ef4444';setTimeout(()=>{mb.style.borderColor='';mb.style.color='';},600);
    return;
  }
  money-=e.price;
  inventory.push({...e,id:Date.now()});
  // Track stats
  if(inventory.length>=slots)stats.bagFills++;
  if(e.mutCls==='mut-gold')stats.mutGold++;
  if(e.mutCls==='mut-master')stats.mutMaster++;
  if(['Legendary','Mythique'].includes(e.rarity))stats.legFound++;
  if(e.rarity==='OG')stats.ogFound++;
  playSFX('buy');
  // Discovery
  const dk=e.name+'__'+(e.mutName||'Normal');
  const isNew=!discovered[dk];
  discovered[dk]=(discovered[dk]||0)+1;
  if(isNew)showDiscovery(e);
  doScroll();
  updateUI();
}

function showDiscovery(e){
  playSFX('disc');
  document.getElementById('discE').textContent=e.symbol;
  document.getElementById('discE').className=e.mutCls||'';
  document.getElementById('discN').textContent=e.name+(mutLbl(e.mut)?' ('+mutLbl(e.mut)+')':'');
  document.getElementById('discR').textContent='✦ '+e.rarity+' ✦';
  document.getElementById('discR').style.color=e.color;
  const ov=document.getElementById('discOv');ov.style.display='flex';setTimeout(()=>ov.style.display='none',3000);
}


function claimQ(id){
  const q=QUESTS.find(x=>x.id===id);
  if(!q||claimed.includes(id))return;
  if(qCurr(q)>=q.target){
    claimed.push(id);money+=q.reward;playSFX('buy');
    showToast('Récompense récupérée ! +'+fmt(q.reward)+' $','ok');
    renderQuests();updateUI();saveGame();
  }
}

